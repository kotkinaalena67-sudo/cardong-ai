const express = require("express");
const OpenAI = require("openai");

const app = express();
app.use(express.json());
app.use(express.static("public"));

const PORT = process.env.PORT || 3000;

const client = new OpenAI({
apiKey: process.env.OPENAI_API_KEY
});

app.get("/api/status", (req, res) => {
res.json({ name: "Cardong", status: "online" });
});

app.post("/api/chat", async (req, res) => {
try {
const message = req.body.message;

if (!message || typeof message !== "string") {
  return res.status(400).json({ error: "Напиши сообщение." });
}

const response = await client.chat.completions.create({
  model: "gpt-4.1-mini",
  messages: [
    {
      role: "system",
      content: "Ты Cardong — полезный, дружелюбный ИИ-помощник. Отвечай на русском языке, если пользователь пишет по-русски."
    },
    { role: "user", content: message.slice(0, 10000) }
  ]
});

res.json({
  reply: response.choices[0].message.content
});

} catch (error) {
console.error("Cardong error:", error.message);
res.status(500).json({
error: "Не удалось получить ответ от ИИ. Проверь настройки сервера."
});
}
});

app.listen(PORT, () => {
console.log("Cardong запущен на порту ${PORT}");
});
